import React, { useState } from "react";
import { LegalCase, LegalDeadline, GanttPhase } from "../types";
import { Calendar as CalendarIcon, Clock, AlertTriangle, CheckSquare, Plus, Trash2, Milestone, Info } from "lucide-react";
import ShamsiDatePicker from "./ShamsiDatePicker";
import DualDateDisplay from "./DualDateDisplay";
import { parseDualDate, toPersianDigits, gregorianToJalali } from "../utils/jalali";

interface CalendarGanttViewProps {
  caseData: LegalCase;
  onUpdateDeadlines: (deadlines: LegalDeadline[]) => void;
  onUpdateGanttPhases: (phases: GanttPhase[]) => void;
}

export default function CalendarGanttView({ caseData, onUpdateDeadlines, onUpdateGanttPhases }: CalendarGanttViewProps) {
  const [newDeadlineTitle, setNewDeadlineTitle] = useState("");
  const [newDeadlineDate, setNewDeadlineDate] = useState("");
  const [newDeadlineType, setNewDeadlineType] = useState<'hearing' | 'objection' | 'submission'>("submission");
  const [newDeadlineDesc, setNewDeadlineDesc] = useState("");

  const [activeDeadlineId, setActiveDeadlineId] = useState<string | null>(null);

  // Calculate days remaining relative to "2026-07-19"
  const getDaysRemaining = (targetDateStr: string): number => {
    const today = new Date("2026-07-19");
    const target = new Date(targetDateStr);
    const diffTime = target.getTime() - today.getTime();
    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
    return isNaN(diffDays) ? 0 : diffDays;
  };

  const handleAddDeadline = (e: React.FormEvent) => {
    e.preventDefault();
    if (!newDeadlineTitle.trim() || !newDeadlineDate) return;

    const daysRemaining = getDaysRemaining(newDeadlineDate);
    const newDL: LegalDeadline = {
      id: `dl-${Date.now()}`,
      title: newDeadlineTitle.trim(),
      date: newDeadlineDate,
      type: newDeadlineType,
      description: newDeadlineDesc.trim() || "توضیحاتی برای این مهلت ثبت نشده است.",
      daysRemaining
    };

    const updated = [...caseData.deadlines, newDL].sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());
    onUpdateDeadlines(updated);
    
    setNewDeadlineTitle("");
    setNewDeadlineDate("");
    setNewDeadlineDesc("");
  };

  const handleDeleteDeadline = (id: string) => {
    const updated = caseData.deadlines.filter(d => d.id !== id);
    onUpdateDeadlines(updated);
  };

  // Simulated July/August 2026 Calendar Grid (Gregorian layout representing Persian month Mordad/Tir 1405)
  // Mordad starts late July 2026. Let's make Mordad Month starting with 31 days.
  // Mordad 1, 1405 matches roughly July 23, 2026.
  // Let's draw July 2026 grid (starts on Wednesday, July 1 is a Wednesday in 2026)
  // Total 31 days in July. Today is July 19.
  const julyDays = Array.from({ length: 31 }, (_, i) => i + 1);
  const startDayOffset = 3; // Wednesday offset (Sunday=0, Mon=1, Tue=2, Wed=3)

  const getDeadlineOnDate = (day: number, month: number): LegalDeadline[] => {
    const monthStr = month < 10 ? `0${month}` : `${month}`;
    const dayStr = day < 10 ? `0${day}` : `${day}`;
    const dateStr = `2026-${monthStr}-${dayStr}`;
    return caseData.deadlines.filter(d => d.date === dateStr);
  };

  return (
    <div id="calendar-gantt-view-card" className="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden flex flex-col h-full text-right">
      {/* Header */}
      <div className="p-6 border-b border-gray-200 bg-gray-50/50">
        <div className="flex flex-wrap items-start justify-between gap-4">
          <div>
            <span className="inline-flex items-center gap-1.5 px-2.5 py-1 text-[10px] font-bold text-indigo-700 bg-indigo-50 rounded uppercase tracking-wider mb-2">
              <CalendarIcon className="w-3.5 h-3.5" />
              مدیریت هوشمند زمان‌بندی پرونده
            </span>
            <h2 className="text-xl font-bold text-gray-800 tracking-tight leading-tight">تقویم و گانت چارت مهلت‌های قانونی</h2>
            <p className="text-xs text-gray-500 mt-1 font-medium">پایش برخط مهلت اعتراض‌ها، تجدیدنظرخواهی، زمان ارسال لوایح و مواعد دادرسی</p>
          </div>
        </div>
      </div>

      <div className="flex-1 p-6 overflow-y-auto max-h-[720px] space-y-6">
        
        {/* Row 1: Calendar Grid & Countdown Alerts */}
        <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
          
          {/* Calendar Display Grid (7 Cols on desktop) */}
          <div className="lg:col-span-7 bg-slate-50 border border-slate-200 rounded-xl p-3 sm:p-5 shadow-inner">
            <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
              <h3 className="text-xs sm:text-sm font-bold text-slate-800 flex items-center gap-2">
                <CalendarIcon className="w-4 h-4 text-indigo-600 shrink-0" />
                <span>نمای تقویم ماه ژوئیه ۲۰۲۶ (تیر - مرداد ۱۴۰۵)</span>
              </h3>
              <div className="flex items-center justify-between sm:justify-start sm:flex-col sm:items-end gap-1">
                <span className="text-xs font-black text-indigo-700 bg-indigo-50 px-2.5 py-0.5 rounded-md border border-indigo-100">امروز: ۲۹ تیر ۱۴۰۵</span>
                <span className="text-[9px] font-mono text-slate-400 leading-none mt-0.5" dir="ltr">Today: 19 Jul 2026</span>
              </div>
            </div>

            {/* Calendar Grid Header */}
            <div className="grid grid-cols-7 gap-1.5 text-center text-[10px] font-black text-slate-400 uppercase tracking-wider mb-2">
              <span>ش</span>
              <span>ی</span>
              <span>د</span>
              <span>س</span>
              <span>چ</span>
              <span>پ</span>
              <span>ج</span>
            </div>

            {/* Calendar Days Container with horizontal scroll safety for narrow viewports */}
            <div className="overflow-x-auto pb-1">
              <div className="min-w-[270px]">
                {/* Calendar Days */}
                <div className="grid grid-cols-7 gap-1 sm:gap-1.5">
                  {/* Empty offsets */}
                  {Array.from({ length: startDayOffset }).map((_, idx) => (
                    <div key={`offset-${idx}`} className="h-10 sm:h-12 rounded-md bg-transparent"></div>
                  ))}

                  {julyDays.map((day) => {
                    const dateDeadlines = getDeadlineOnDate(day, 7);
                    const isToday = day === 19;
                    const hasDeadlines = dateDeadlines.length > 0;
                    const j = gregorianToJalali(2026, 7, day);
                    
                    // Get color of first deadline
                    let dotColor = "bg-indigo-600";
                    if (hasDeadlines) {
                      const type = dateDeadlines[0].type;
                      if (type === 'hearing') dotColor = "bg-amber-500";
                      else if (type === 'objection') dotColor = "bg-rose-500";
                      else dotColor = "bg-blue-500";
                    }

                    return (
                      <div
                        key={day}
                        onClick={() => {
                          if (hasDeadlines) {
                            setActiveDeadlineId(dateDeadlines[0].id);
                          }
                        }}
                        className={`h-10 sm:h-12 rounded-lg border flex flex-col justify-between p-1 sm:p-1.5 transition relative cursor-pointer ${
                          isToday 
                            ? "bg-indigo-600 border-indigo-600 text-white shadow-md shadow-indigo-500/20" 
                            : hasDeadlines
                            ? "bg-white hover:bg-slate-100 border-indigo-200 text-slate-800 ring-2 ring-indigo-500/5"
                            : "bg-white hover:bg-slate-150 border-slate-150 text-slate-600"
                        }`}
                      >
                        <div className="flex items-start justify-between">
                          <span className={`text-[11px] sm:text-xs font-black leading-none ${isToday ? "text-white" : "text-slate-800"}`}>
                            {toPersianDigits(j.jd)}
                          </span>
                          <span className={`text-[7px] sm:text-[8px] font-mono leading-none ${isToday ? "text-indigo-200" : "text-slate-400"}`}>
                            {day}
                          </span>
                        </div>
                        {hasDeadlines && (
                          <span className={`w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full self-center mb-0.5 ${dotColor}`}></span>
                        )}
                        {isToday && (
                          <span className="text-[6px] sm:text-[7px] font-bold text-center uppercase tracking-widest leading-none text-indigo-100 mb-0.5">امروز</span>
                        )}
                      </div>
                    );
                  })}
                </div>
              </div>
            </div>

            {/* Calendar Legend */}
            <div className="flex flex-wrap gap-4 items-center justify-center mt-4 text-[10px] font-bold text-slate-400">
              <span className="flex items-center gap-1.5">
                <span className="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
                جلسه اول دادرسی (جلسات دادگاه)
              </span>
              <span className="flex items-center gap-1.5">
                <span className="w-2.5 h-2.5 rounded-full bg-rose-500"></span>
                مهلت‌های اعتراض قضایی
              </span>
              <span className="flex items-center gap-1.5">
                <span className="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
                ارسال لایحه دفاعیه به شعبه
              </span>
            </div>
          </div>

          {/* Countdown & Tight Deadlines Column (5 Cols) */}
          <div className="lg:col-span-5 flex flex-col h-full space-y-4">
            <div className="bg-white border border-slate-200 rounded-xl p-5 shadow-sm flex-1">
              <h3 className="text-sm font-bold text-slate-800 flex items-center gap-2 mb-3 pb-2 border-b border-slate-100">
                <Clock className="w-4 h-4 text-indigo-600 animate-spin" />
                <span>روز شمار مهلت‌های حساس پرونده (Deadlines)</span>
              </h3>

              <div className="space-y-2.5 max-h-[300px] overflow-y-auto pr-1">
                {caseData.deadlines.map((dl) => {
                  const daysLeft = getDaysRemaining(dl.date);
                  const isTight = daysLeft <= 7;
                  
                  return (
                    <div 
                      key={dl.id}
                      onClick={() => setActiveDeadlineId(dl.id === activeDeadlineId ? null : dl.id)}
                      className={`p-3 rounded-lg border cursor-pointer transition ${
                        activeDeadlineId === dl.id
                          ? 'border-indigo-500 bg-indigo-50/20'
                          : isTight
                          ? 'border-rose-100 bg-rose-50/40 hover:bg-rose-50'
                          : 'border-slate-150 bg-slate-50/50 hover:bg-slate-50'
                      }`}
                    >
                      <div className="flex justify-between items-start gap-2">
                        <div className="space-y-1">
                          <span className={`px-1.5 py-0.5 rounded text-[8px] font-black ${
                            dl.type === 'hearing' 
                              ? 'bg-amber-100 text-amber-700' 
                              : dl.type === 'objection'
                              ? 'bg-rose-100 text-rose-700'
                              : 'bg-blue-100 text-blue-700'
                          }`}>
                            {dl.type === 'hearing' ? 'جلسه دادگاه' : dl.type === 'objection' ? 'اعتراض قضایی' : 'ارسال لایحه'}
                          </span>
                          <h4 className="text-xs font-bold text-slate-800">{dl.title}</h4>
                        </div>
                        <span className={`px-2 py-1 text-[10px] font-bold rounded-full ${
                          isTight 
                            ? "bg-rose-600 text-white" 
                            : daysLeft <= 15
                            ? "bg-amber-500 text-white"
                            : "bg-indigo-50 text-indigo-700"
                        }`}>
                          {daysLeft > 0 ? `${daysLeft} روز مانده` : "مهلت منقضی شده"}
                        </span>
                      </div>

                      {activeDeadlineId === dl.id && (
                        <div className="mt-2.5 pt-2.5 border-t border-dashed border-slate-200 text-[11px] text-slate-500 leading-relaxed">
                          <p>{dl.description}</p>
                          <div className="mt-2 pt-2 border-t border-slate-100">
                            <span className="text-[10px] font-bold text-slate-500 block mb-1">تاریخ موعد قانونی:</span>
                            <DualDateDisplay date={dl.date} format="text" showIcon />
                          </div>
                          <button
                            type="button"
                            onClick={(e) => {
                              e.stopPropagation();
                              handleDeleteDeadline(dl.id);
                            }}
                            className="mt-2 text-rose-500 hover:text-rose-700 flex items-center gap-1 font-bold cursor-pointer"
                          >
                            <Trash2 className="w-3 h-3" />
                            <span>حذف زمان‌بندی</span>
                          </button>
                        </div>
                      )}
                    </div>
                  );
                })}
              </div>
            </div>
          </div>

        </div>

        {/* Row 2: Professional Gantt Chart (گانت چارت حرفه‌ای پرونده) */}
        <div className="bg-white border border-slate-200 rounded-xl p-5 shadow-sm">
          <div className="flex justify-between items-center mb-4 pb-2 border-b border-slate-100">
            <h3 className="text-sm font-bold text-slate-800 flex items-center gap-2">
              <Milestone className="w-4.5 h-4.5 text-indigo-600" />
              <span>گانت چارت حرفه‌ای پیشرفت دادرسی (Gantt Chart)</span>
            </h3>
            <span className="text-[10px] text-indigo-600 font-bold bg-indigo-50 px-2 py-0.5 rounded">زمان‌بندی فازها</span>
          </div>

          <div className="space-y-4">
            {caseData.ganttPhases.map((phase) => {
              const startDays = getDaysRemaining(phase.startDate);
              const endDays = getDaysRemaining(phase.endDate);
              const startParsed = parseDualDate(phase.startDate);
              const endParsed = parseDualDate(phase.endDate);
              
              // Map percentage progress visually with stylish labels
              return (
                <div key={phase.id} className="grid grid-cols-1 md:grid-cols-12 gap-3 items-center">
                  <div className="md:col-span-3 space-y-1">
                    <h4 className="text-xs font-bold text-slate-800">{phase.name}</h4>
                    <div className="text-[10px] space-y-0.5">
                      <div className="font-bold text-slate-700">
                        <span>{startParsed.shamsiText}</span>
                        <span className="mx-1 text-slate-400">تا</span>
                        <span>{endParsed.shamsiText}</span>
                      </div>
                      <div className="text-[9px] font-mono text-slate-400 font-medium tracking-tight" dir="ltr">
                        {phase.startDate} to {phase.endDate}
                      </div>
                    </div>
                  </div>

                  {/* Gantt Bar Block */}
                  <div className="md:col-span-7 bg-slate-100 h-6 rounded-full relative overflow-hidden flex items-center p-1 border border-slate-200">
                    <div 
                      className="h-full rounded-full transition-all duration-300"
                      style={{ 
                        width: `${phase.progress}%`,
                        backgroundColor: phase.color === 'emerald' ? '#10b981' : phase.color === 'indigo' ? '#4f46e5' : phase.color === 'amber' ? '#f59e0b' : '#3b82f6'
                      }}
                    />
                    <span className="absolute right-3 text-[10px] font-bold text-slate-700 bg-white/80 px-1.5 py-0.5 rounded shadow-sm">
                      {phase.progress}% پیشرفت
                    </span>
                  </div>

                  <div className="md:col-span-2 text-left text-[10px] font-black text-slate-400" dir="ltr">
                    {startDays > 0 ? `شروع در ${startDays} روز` : endDays > 0 ? `اتمام در ${endDays} روز` : "اتمام یافته"}
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        {/* Row 3: Add Custom Deadline Form */}
        <div className="bg-slate-50 border border-slate-200 rounded-xl p-5 shadow-sm">
          <h4 className="text-xs font-bold text-slate-700 mb-3 flex items-center gap-1.5">
            <Plus className="w-4 h-4 text-indigo-600" />
            <span>افزودن مهلت قانونی یا تاریخ جلسه جدید به تقویم</span>
          </h4>

          <form onSubmit={handleAddDeadline} className="space-y-3 text-xs">
            <div className="grid grid-cols-1 md:grid-cols-12 gap-3 items-start">
              <div className="md:col-span-4 space-y-1">
                <label className="block text-[11px] font-bold text-slate-700">عنوان مهلت یا رویداد:</label>
                <input
                  required
                  type="text"
                  value={newDeadlineTitle}
                  onChange={(e) => setNewDeadlineTitle(e.target.value)}
                  placeholder="مثلاً: جلسه اول بازپرسی، مهلت فرجام‌خواهی..."
                  className="w-full px-3 py-2 bg-white border border-slate-300 focus:border-indigo-500 rounded-lg outline-none shadow-xs"
                />
              </div>

              <div className="md:col-span-5 bg-white p-2.5 rounded-lg border border-slate-200">
                <ShamsiDatePicker
                  label="تاریخ رویداد به تقویم شمسی:"
                  required
                  value={newDeadlineDate}
                  onChange={(gIso) => setNewDeadlineDate(gIso)}
                />
              </div>

              <div className="md:col-span-3 space-y-1">
                <label className="block text-[11px] font-bold text-slate-700">نوع رویداد قضایی:</label>
                <select
                  value={newDeadlineType}
                  onChange={(e) => setNewDeadlineType(e.target.value as any)}
                  className="w-full px-3 py-2 bg-white border border-slate-300 focus:border-indigo-500 rounded-lg outline-none cursor-pointer shadow-xs"
                >
                  <option value="submission">ارسال لایحه دفاعیه</option>
                  <option value="hearing">تاریخ جلسه دادرسی (دادگاه)</option>
                  <option value="objection">مهلت واخواهی / تجدیدنظرخواهی</option>
                </select>
              </div>
            </div>

            <div className="flex justify-end pt-1">
              <button
                type="submit"
                disabled={!newDeadlineTitle.trim() || !newDeadlineDate}
                className="px-5 py-2 bg-indigo-600 hover:bg-indigo-700 disabled:opacity-50 text-white font-bold rounded-lg transition shadow-xs cursor-pointer flex items-center gap-1.5"
              >
                <Plus className="w-4 h-4" />
                <span>ثبت در تقویم و روزشمار</span>
              </button>
            </div>
          </form>
        </div>

      </div>
    </div>
  );
}
