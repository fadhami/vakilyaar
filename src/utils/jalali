/**
 * Jalali (Solar Hijri / Shamsi) <-> Gregorian (Miladi) Date Utility
 * Fully bidirectional, mathematically precise algorithm.
 */

export const JALALI_MONTH_NAMES = [
  "فروردین",
  "اردیبهشت",
  "خرداد",
  "تیر",
  "مرداد",
  "شهریور",
  "مهر",
  "آبان",
  "آذر",
  "دی",
  "بهمن",
  "اسفند"
];

export const GREGORIAN_MONTH_NAMES = [
  "Jan", "Feb", "Mar", "Apr", "May", "Jun",
  "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
];

export const PERSIAN_WEEKDAYS = [
  "شنبه",
  "یکشنبه",
  "دوشنبه",
  "سه‌شنبه",
  "چهارشنبه",
  "پنج‌شنبه",
  "جمعه"
];

export function toPersianDigits(input: string | number): string {
  const persianDigits = ["۰", "۱", "۲", "۳", "۴", "۵", "۶", "۷", "۸", "۹"];
  return String(input).replace(/[0-9]/g, (char) => persianDigits[parseInt(char, 10)]);
}

export function toEnglishDigits(input: string): string {
  const persianDigits = ["۰", "۱", "۲", "۳", "۴", "۵", "۶", "۷", "۸", "۹"];
  const arabicDigits = ["٠", "١", "٢", "٣", "٤", "٥", "٦", "٧", "٨", "٩"];
  
  let result = input;
  for (let i = 0; i < 10; i++) {
    result = result.replace(new RegExp(persianDigits[i], "g"), String(i));
    result = result.replace(new RegExp(arabicDigits[i], "g"), String(i));
  }
  return result;
}

export function gregorianToJalali(gy: number, gm: number, gd: number): { jy: number; jm: number; jd: number } {
  const g_d_m = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334];
  let jy = (gy > 1600) ? 979 : 0;
  let gYear = gy - ((gy > 1600) ? 1600 : 621);
  const isLeap = (gy % 4 === 0 && gy % 100 !== 0) || (gy % 400 === 0);
  const gy2 = (gm > 2) ? (gYear + 1) : gYear;
  let days = (365 * gYear) + Math.floor((gy2 + 3) / 4) - Math.floor((gy2 + 99) / 100) + Math.floor((gy2 + 399) / 400) - 80 + gd + g_d_m[gm - 1];
  if (gm > 2 && isLeap) days++;

  jy += 33 * Math.floor(days / 12053);
  days %= 12053;

  jy += 4 * Math.floor(days / 1461);
  days %= 1461;

  if (days > 365) {
    jy += Math.floor((days - 1) / 365);
    days = (days - 1) % 365;
  }

  const jm = (days < 186) ? (1 + Math.floor(days / 31)) : (7 + Math.floor((days - 186) / 30));
  const jd = (days < 186) ? (1 + (days % 31)) : (1 + ((days - 186) % 30));
  return { jy, jm, jd };
}

export function jalaliToGregorian(jy: number, jm: number, jd: number): { gy: number; gm: number; gd: number } {
  let gy = (jy > 979) ? 1600 : 621;
  let jYear = jy - ((jy > 979) ? 979 : 0);
  let days = (365 * jYear) + (Math.floor(jYear / 33) * 8) + Math.floor(((jYear % 33) + 3) / 4) + 78 + jd + ((jm < 7) ? (jm - 1) * 31 : ((jm - 7) * 30 + 186));

  gy += 400 * Math.floor(days / 146097);
  days %= 146097;

  if (days >= 36525) {
    days--;
    gy += 100 * Math.floor(days / 36524);
    days %= 36524;
    if (days >= 365) days++;
  }

  gy += 4 * Math.floor(days / 1461);
  days %= 1461;

  if (days >= 366) {
    days--;
    gy += Math.floor(days / 365);
    days %= 365;
  }

  const sal_a = [0, 31, ((gy % 4 === 0 && gy % 100 !== 0) || (gy % 400 === 0)) ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
  let gm = 0;
  let gd = 0;
  for (let i = 0; i < 13; ++i) {
    if (days < sal_a[i]) {
      gm = i;
      gd = days + 1;
      break;
    }
    days -= sal_a[i];
  }
  return { gy, gm, gd };
}

export function isJalaliLeapYear(jy: number): boolean {
  const breaks = [-61, 9, 38, 199, 426, 686, 756, 818, 1111, 1181, 1210, 1635, 2060, 2097, 2192, 2262, 2324, 2394, 2456, 3178];
  let jp = breaks[0];
  let jump = 0;
  for (let i = 1; i < breaks.length; i++) {
    const jm = breaks[i];
    jump = jm - jp;
    if (jy < jm) break;
    jp = jm;
  }
  let n = jy - jp;
  if (n < 0) n += 33;
  return (n % 33 % 4 === 1);
}

export function getDaysInJalaliMonth(jy: number, jm: number): number {
  if (jm >= 1 && jm <= 6) return 31;
  if (jm >= 7 && jm <= 11) return 30;
  if (jm === 12) return isJalaliLeapYear(jy) ? 30 : 29;
  return 30;
}

export interface ParsedDualDate {
  shamsi: string; // e.g. "۱۴۰۵/۰۶/۲۳"
  shamsiPlain: string; // e.g. "1405/06/23"
  shamsiText: string; // e.g. "۲۳ شهریور ۱۴۰۵"
  gregorian: string; // e.g. "2026-09-14"
  gregorianText: string; // e.g. "14 Sep 2026"
  jy: number;
  jm: number;
  jd: number;
  gy: number;
  gm: number;
  gd: number;
}

/**
 * Parses either a Gregorian string ("YYYY-MM-DD" or Date) or a Shamsi string ("1405/06/23" or "1405-06-23")
 */
export function parseDualDate(dateInput?: string | Date | null): ParsedDualDate {
  const now = new Date();
  
  if (!dateInput) {
    const g = { gy: now.getFullYear(), gm: now.getMonth() + 1, gd: now.getDate() };
    const j = gregorianToJalali(g.gy, g.gm, g.gd);
    return buildDualResult(j.jy, j.jm, j.jd, g.gy, g.gm, g.gd);
  }

  if (dateInput instanceof Date) {
    const gy = dateInput.getFullYear();
    const gm = dateInput.getMonth() + 1;
    const gd = dateInput.getDate();
    const j = gregorianToJalali(gy, gm, gd);
    return buildDualResult(j.jy, j.jm, j.jd, gy, gm, gd);
  }

  const clean = toEnglishDigits(String(dateInput).trim());

  // Check if it's Shamsi (year >= 1300 and < 1500)
  const parts = clean.split(/[-/.]/).map(p => parseInt(p, 10)).filter(n => !isNaN(n));
  if (parts.length >= 3) {
    if (parts[0] >= 1300 && parts[0] <= 1500) {
      // It's a Shamsi date: YYYY/MM/DD
      const jy = parts[0];
      const jm = Math.min(12, Math.max(1, parts[1]));
      const jd = Math.min(31, Math.max(1, parts[2]));
      const g = jalaliToGregorian(jy, jm, jd);
      return buildDualResult(jy, jm, jd, g.gy, g.gm, g.gd);
    } else if (parts[0] > 1900 && parts[0] < 2100) {
      // It's a Gregorian date: YYYY-MM-DD
      const gy = parts[0];
      const gm = Math.min(12, Math.max(1, parts[1]));
      const gd = Math.min(31, Math.max(1, parts[2]));
      const j = gregorianToJalali(gy, gm, gd);
      return buildDualResult(j.jy, j.jm, j.jd, gy, gm, gd);
    }
  }

  // Fallback to Date parser
  const parsed = new Date(clean);
  if (!isNaN(parsed.getTime())) {
    const gy = parsed.getFullYear();
    const gm = parsed.getMonth() + 1;
    const gd = parsed.getDate();
    const j = gregorianToJalali(gy, gm, gd);
    return buildDualResult(j.jy, j.jm, j.jd, gy, gm, gd);
  }

  // Fallback to today
  const gy = now.getFullYear();
  const gm = now.getMonth() + 1;
  const gd = now.getDate();
  const j = gregorianToJalali(gy, gm, gd);
  return buildDualResult(j.jy, j.jm, j.jd, gy, gm, gd);
}

function pad(num: number): string {
  return num < 10 ? `0${num}` : `${num}`;
}

function buildDualResult(jy: number, jm: number, jd: number, gy: number, gm: number, gd: number): ParsedDualDate {
  const shamsiPlain = `${jy}/${pad(jm)}/${pad(jd)}`;
  const shamsi = toPersianDigits(shamsiPlain);
  const monthName = JALALI_MONTH_NAMES[jm - 1] || "";
  const shamsiText = `${toPersianDigits(jd)} ${monthName} ${toPersianDigits(jy)}`;

  const gregorian = `${gy}-${pad(gm)}-${pad(gd)}`;
  const gMonthName = GREGORIAN_MONTH_NAMES[gm - 1] || "";
  const gregorianText = `${gd} ${gMonthName} ${gy}`;

  return {
    shamsi,
    shamsiPlain,
    shamsiText,
    gregorian,
    gregorianText,
    jy,
    jm,
    jd,
    gy,
    gm,
    gd
  };
}

/**
 * Returns today's parsed dual date
 */
export function getTodayDualDate(): ParsedDualDate {
  return parseDualDate(new Date());
}

/**
 * Returns full Shamsi text, e.g. "۲۳ شهریور ۱۴۰۵"
 */
export function formatJalaliFull(dateInput?: string | Date | null): string {
  return parseDualDate(dateInput).shamsiText;
}
